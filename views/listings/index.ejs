<% layout("layouts/boilerplate")%>

    <div id="filters-container">
        <div id="filters">
            <a href="/listings" class="filter-item <%= !category ? 'active' : '' %>">
                <i class="fa-solid fa-border-all"></i>
                <p>All</p>
            </a>

            <a href="/listings?category=trending" class="filter-item <%= category === 'trending' ? 'active' : '' %>">
                <i class="fa-solid fa-fire"></i>
                <p>Trending</p>
            </a>

            <a href="/listings?category=rooms" class="filter-item <%= category === 'rooms' ? 'active' : '' %>">
                <i class="fa-solid fa-bed"></i>
                <p>Rooms</p>
            </a>

            <a href="/listings?category=iconic cities" class="filter-item <%= category === 'iconic cities' ? 'active' : '' %>">
                <i class="fa-solid fa-mountain-city"></i>
                <p>Iconic Cities</p>
            </a>

            <a href="/listings?category=mountains" class="filter-item <%= category === 'mountains' ? 'active' : '' %>">
                <i class="fa-solid fa-mountain"></i>
                <p>Mountains</p>
            </a>

            <a href="/listings?category=castles" class="filter-item <%= category === 'castles' ? 'active' : '' %>">
                <i class="fa-brands fa-fort-awesome"></i>
                <p>Castles</p>
            </a>

            <a href="/listings?category=amazing pools" class="filter-item <%= category === 'amazing pools' ? 'active' : '' %>">
                <i class="fa-solid fa-person-swimming"></i>
                <p>Amazing Pools</p>
            </a>

            <a href="/listings?category=camping" class="filter-item <%= category === 'camping' ? 'active' : '' %>">
                <i class="fa-solid fa-campground"></i>
                <p>Camping</p>
            </a>

            <a href="/listings?category=farms" class="filter-item <%= category === 'farms' ? 'active' : '' %>">
                <i class="fa-solid fa-cow"></i>
                <p>Farms</p>
            </a>

            <a href="/listings?category=arctic" class="filter-item <%= category === 'arctic' ? 'active' : '' %>">
                <i class="fa-regular fa-snowflake"></i>
                <p>Arctic</p>
            </a>

            <a href="/listings?category=beach" class="filter-item <%= category === 'beach' ? 'active' : '' %>">
                <i class="fa-solid fa-umbrella-beach"></i>
                <p>Beach</p>
            </a>

            <a href="/listings?category=domes" class="filter-item <%= category === 'domes' ? 'active' : '' %>">
                <i class="fa-solid fa-igloo"></i>
                <p>Domes</p>
            </a>

            <a href="/listings?category=boats" class="filter-item <%= category === 'boats' ? 'active' : '' %>">
                <i class="fa-solid fa-ship"></i>
                <p>Boats</p>
            </a>
        </div>

        <div class="tax-toggle">
            <div class="form-check form-switch form-check-reverse m-0">
                <input class="form-check-input" type="checkbox" role="switch" id="filterTaxSwitch">
                <label class="form-check-label" for="filterTaxSwitch">Display total after taxes</label>
            </div>
        </div>
    </div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let listing of allListings) { %>
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card col listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b>
                                <%= listing.title %>
                            </b> <br>
                            &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                        </p>
                    </div>
                </div>
            </a>
            <% } %>
    </div>