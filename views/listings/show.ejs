<% layout("layouts/boilerplate")%>

    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3>
                <%= listing.title %>
            </h3>
        </div>

        <div class="card col-6 offset-3 show-card listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body mt-2">
                <p class="card-text">
                    <b>@ <%= listing.owner.username %></b><br>
                    <%= listing.description %>
                </p>
                <p class="card-text">
                    &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                </p>
                <p class="card-text">
                    <i class="fa-solid fa-location-dot text-danger"></i>
                    <%= listing.location %>, <%= listing.country %>
                </p>
            </div>
        </div>

        <% if(currUser && listing.owner._id.equals(currUser._id )) { %>
            <div class="col-6 offset-3 d-flex gap-3 mb-5">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit</a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-dark">Delete</button>
                </form>
            </div>
            <% } %>

                <div class="col-8 offset-3 mb-3">
                    <hr>
                    <h3>Leave a Review</h3>

                    <%if(currUser){%>
                        <form method="POST" action="/listings/<%= listing._id %>/reviews" class="needs-validation"
                            novalidate>
                            <div class="mb-3">
                                <fieldset class="starability-slot">
                                    <legend>Rating :</legend>
                                    <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0"
                                        checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="rating" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="rating" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="rating" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="rating" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="rating" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>
                            <div class="mb-3">
                                <label for="comment">Comments</label>
                                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                                    required></textarea>
                                <div class="invalid-feedback">
                                    Please enter a comment
                                </div>
                            </div>
                            <button class="btn btn-outline-dark mt-2">Submit</button>
                        </form>
                        <%}else{%>
                            <p>Login to add review</p>
                            <%}%>
                                <hr>

                                <p><b>ALL REVIEWS</b></p>

                                <div class="row">
                                    <%for(review of listing.reviews) {%>
                                        <div class="card col-6 mb-3">
                                            <div class="card-body">
                                                <h5 class="card-title">
                                                    <%= review.author.username %>
                                                </h5>
                                                <p class="card-text">
                                                    <%= review.comment%>
                                                </p>
                                                <p class="starability-result" data-rating="<%=review.rating%>"></p>
                                            </div>
                                            <form class="mb-3" method="POST"
                                                action="/listings/<%= listing._id%>/reviews/<%= review._id %>?_method=DELETE">
                                                <button class="btn btn-md btn-outline-danger">Delete</button>
                                            </form>
                                        </div>
                                        <% } %>
                                </div>

                </div>
    </div>