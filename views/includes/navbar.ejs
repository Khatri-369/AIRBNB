<style>
    .btn-search {
        background-color: #ff385c;
        color: white;
        border: none;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s ease;
        flex-shrink: 0;
    }

    .btn-search:hover {
        background-color: #e31c5f;
        color: white;
        transform: scale(1.05);
    }

    .search-inp {
        border: 1px solid #ddd !important;
        border-radius: 25px !important;
        height: 42px;
        padding: 0 1.25rem !important;
        width: 18rem !important;
        font-size: 0.85rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .search-inp:focus {
        border-color: #ff385c !important;
        box-shadow: 0 0 0 0.15rem rgba(255, 56, 92, 0.25) !important;
    }

    @media (min-width: 992px) {
        .navbar-search-center {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }
    }

    @media (max-width: 991px) {
        .navbar-search-center {
            width: 100%;
            margin: 0.75rem 0;
        }

        .search-inp {
            width: 100% !important;
            margin-bottom: 0.5rem;
        }
    }
</style>

<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top">
    <div class="container-fluid position-relative">
        <a class="navbar-brand" href="/"><i class="fa-regular fa-compass"></i></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav">
                <a class="nav-link" href="/listings">Explore</a>
            </div>

            <div class="navbar-search-center">
                <form class="d-flex align-items-center" role="search" action="/listings" method="GET">
                    <input class="form-control search-inp me-2" type="search" placeholder="Search destinations" aria-label="Search"
                        name="search" value="<%= typeof search !== 'undefined' && search ? search : '' %>">
                    <button class="btn-search" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </form>
            </div>

            <div class="navbar-nav ms-auto align-items-lg-center">
                <a class="nav-link" href="/listings/new"><b>Add Your Home</b></a>
                <% if(currUser){ %>
                    <a class="nav-link ms-lg-2" href="/logout"><b>Log Out</b></a>
                <% } else { %>
                    <a class="nav-link ms-lg-2" href="/login"><b>Login</b></a>
                    <a class="nav-link ms-lg-2" href="/signup"><b>Sign Up</b></a>
                <% } %>
            </div>
        </div>
    </div>
</nav>